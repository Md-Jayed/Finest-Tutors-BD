# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CLIENT (Frontend - Safe for Browser)
# Project URL from Supabase Project Settings > API (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Publishable / Anon Key (Safe for browser / client-side)
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key-here"

# (Optional fallback for legacy Supabase setups)
# VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key-here"

# CRITICAL SECURITY NOTICE:
# DO NOT place SUPABASE_SERVICE_ROLE_KEY or any database connection strings in this file or any frontend code!
# The service-role key belongs strictly inside Supabase Edge Functions environment variables.
